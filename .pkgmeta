# BigWigs packager: builds the release zip and uploads it (see .github/workflows/release.yml).
package-as: XPForever

# Curated changelog instead of the commit list; shown on CurseForge and in the GitHub release.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md
  - docs
  - .github
  - .luacheckrc
